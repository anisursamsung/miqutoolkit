prefix=/usr
exec_prefix=/usr
libdir=/usr/lib
includedir=/usr/include

Name: biwaytoolkit
Description: High-level C++ UI Toolkit for Biway and Wayland Layer-Shell applications
Version: 1.0.0
Requires: wayland-client xkbcommon cairo pangocairo gdk-pixbuf-2.0
Libs: -L${libdir} -lbiwaytoolkit
Cflags: -I${includedir}
